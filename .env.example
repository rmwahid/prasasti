# ===========================================
# Prasasti - Environment Configuration
# ===========================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://prasasti:prasasti_secret@db:5432/prasasti
DATABASE_URL_SYNC=postgresql+psycopg2://prasasti:prasasti_secret@db:5432/prasasti
POSTGRES_USER=prasasti
POSTGRES_PASSWORD=prasasti_secret
POSTGRES_DB=prasasti

# --- Face Recognition ---
FACE_ENGINE=facenet
FACE_MODEL=facenet-vggface2
FACE_MATCH_THRESHOLD=0.60
FACE_TOP_K=5
FACE_EMBEDDING_DIM=512

# --- Storage ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://admin.localhost:5173"]
